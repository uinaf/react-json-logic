{
  "name": "react-json-logic-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run react-json-logic#build",
    "build:example": "vp run -t @react-json-logic/example#build",
    "dev:example": "vp run react-json-logic#build && vp run -r --parallel dev",
    "preview:example": "vp run @react-json-logic/example#preview",
    "test": "pnpm -r run test",
    "check": "pnpm -r run check",
    "verify": "pnpm -r run verify"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260526.1",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.2.2"
}
