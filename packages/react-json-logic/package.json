    "@typescript/native-preview": "7.0.0-dev.20260517.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.7",
    "bumpp": "^11.1.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
