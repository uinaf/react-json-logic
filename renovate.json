{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platformAutomerge": true,
  "extends": [
    "github>uinaf/renovate-config"
  ],
  "packageRules": [
    {
      "description": "TypeScript majors are opt-in from the dependency dashboard",
      "matchPackageNames": [
        "typescript"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "@vitest/coverage-v8 must equal the vitest version vite-plus bundles; bump it with vite-plus",
      "matchPackageNames": [
        "@vitest/coverage-v8"
      ],
      "enabled": false
    }
  ]
}
